# ---------------------------------------------------------------------------
# Supabase — Painel do projeto > Settings > API
# ---------------------------------------------------------------------------

# "Project URL"
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# "service_role" (secret). NUNCA use o prefixo NEXT_PUBLIC_ nesta chave:
# ela ignora todas as regras de segurança do banco e só pode existir no servidor.
SUPABASE_SERVICE_ROLE_KEY=troque-pela-sua-chave-service-role
